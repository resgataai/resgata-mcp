{
  "name": "resgata-mcp",
  "version": "0.0.0",
  "private": true,
  "description": "Servidor MCP oficial da Resgata.ai",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "bun@1.3.12",
  "engines": {
    "node": ">=22.18.0 <23"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/principal.js",
    "dev:demo": "MCP_MODO=demo bun src/principal.ts",
    "lint": "biome check .",
    "tipos": "tsc --noEmit",
    "test": "vitest run",
    "segredos": "sh scripts/segredos.sh",
    "nomes": "bun scripts/nomes-proibidos.ts",
    "drift:v2": "bun scripts/drift-v2.ts",
    "catalogo:check": "bun scripts/checar-catalogo.ts",
    "gate": "sh scripts/gate.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "2.0.2",
    "@modelcontextprotocol/server": "2.4.0",
    "express": "5.3.0",
    "jose": "6.2.15",
    "oidc-provider": "9.13.3",
    "openid-client": "6.8.9",
    "pino": "10.4.0",
    "prom-client": "15.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "trustedDependencies": []
}
